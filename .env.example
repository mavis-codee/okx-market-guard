# Copy to .env and fill in only if your network needs a proxy.
# NODE_USE_ENV_PROXY is only honored at Node process start (not from --env-file).
# Never put API keys, secrets or passphrases in this file — this project does not use them.

NODE_USE_ENV_PROXY=1
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
NO_PROXY=localhost,127.0.0.1
