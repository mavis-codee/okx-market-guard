{
  "name": "okx-market-guard",
  "version": "0.1.0",
  "description": "Read-only OKX public market data MCP server + CLI. No keys, no orders, no account access.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.6"
  },
  "bin": {
    "okx-market-guard": "./src/cli.ts"
  },
  "scripts": {
