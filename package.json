    "demo": "node demo/demo.ts",
    "test": "node --test \"test/*.test.ts\"",
    "test:live": "node --test test/live-api.test.ts",
    "cli:help": "node src/cli.ts --help"
  },
  "keywords": [
    "okx",
    "mcp",
    "market-data",
    "read-only",
    "cli"
  ]
}
